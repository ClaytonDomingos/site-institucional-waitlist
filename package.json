{
  "name": "clayton-ari-meu-guia-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env.local api/src/index.ts",
    "db:local": "node scripts/db-local.mjs",
    "build": "tsc -b && vite build && tsc -p api",
    "start": "node api/dist/index.js",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p api --noEmit",
    "testar:api": "tsx scripts/testar-api.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.544.0",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@electric-sql/pglite-socket": "^0.2.12",
    "@tailwindcss/vite": "^4.1.13",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "^1.64.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.17.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
