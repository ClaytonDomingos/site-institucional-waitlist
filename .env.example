# Para onde vão as inscrições da lista de espera (veja docs/LISTA-DE-ESPERA.md).
# Copie para .env.local (dev) ou cadastre no painel da hospedagem (Vercel, Netlify…).
# Sem nenhuma variável, o site roda em modo demonstração: guarda no localStorage do navegador.

# 1) Supabase (recomendado): URL do projeto + chave publicável (sb_publishable_…; a antiga anon também serve)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 2) Ou um webhook que recebe o formulário: n8n, Make, Zapier ou Google Apps Script (planilha)
VITE_LISTA_ESPERA_WEBHOOK=
