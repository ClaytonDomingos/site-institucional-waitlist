# Copie para .env.local para desenvolver com a API de verdade (veja docs/LISTA-DE-ESPERA.md).
# Sem .env.local, o site roda em modo demonstração: guarda as inscrições no localStorage do navegador.

# ---------- site (Vite) ----------
# Onde fica a API. No dev, o Vite repassa /api para a API em localhost:8787 (vite.config.ts).
# Em produção já vem de .env.production (/api: o mesmo servidor serve site e API).
VITE_LISTA_ESPERA_API=/api

# ---------- API (Hono, api/) ----------
# Postgres. Local: pnpm db:local (em memória). No Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54320/postgres
# Conexões com o banco (o pnpm db:local aceita 1)
PG_MAX=1
# Usuário e senha para baixar a lista em /api/lista-espera.csv (sem senha, a rota fica desligada)
ADMIN_USUARIO=admin
ADMIN_SENHA=
# Inscrições aceitas por IP a cada 10 minutos
LIMITE_POR_IP=10
